---
import { Image } from 'astro:assets';
import { TOTAL_STARS, formatStars } from '../data/projects';
import zedisShot from '../assets/screenshots/zedis-1.png';
import cyberapiShot from '../assets/screenshots/cyberapi-1.png';
---

<section class="relative pt-8 sm:pt-12 lg:pt-14">
  <div class="mx-auto flex max-w-[880px] flex-col items-center text-center">
    <!-- Eyebrow -->
    <a
      href="https://github.com/vicanso"
      target="_blank"
      rel="noopener noreferrer"
      class="hero-in pill-gradient group inline-flex items-center gap-2.5 py-1 pl-1 pr-3.5 text-[12.5px] font-medium backdrop-blur-md transition-transform hover:scale-[1.02]"
      style="--d: 0ms; color: var(--text-secondary);"
    >
      <img src="/icons/avatar.png" alt="" width="24" height="24" class="h-6 w-6 rounded-full object-cover" />
      <span data-i18n-key="heroEyebrow">Hi, I'm Vicanso — indie Rust developer</span>
      <svg class="h-3 w-3 opacity-60 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </a>

    <!-- Headline -->
    <h1 class="hero-title font-display hero-in mt-5 font-bold" style="--d: 80ms;">
      <span class="text-gradient-fade block" data-i18n-key="heroLine1">Native software,</span>
      <span class="text-gradient-brand block pb-2" data-i18n-key="heroLine2">forged in Rust.</span>
    </h1>

    <p
      class="hero-in mt-4 max-w-[620px] text-[16px] leading-relaxed sm:text-[17.5px]"
      style="--d: 160ms; color: var(--text-secondary);"
      data-i18n-key="heroSubtitle"
    >
      Crafting ultra-fast native apps & network infrastructure in Rust.
    </p>

    <!-- CTAs -->
    <div class="hero-in mt-7 flex flex-wrap items-center justify-center gap-3" style="--d: 240ms;">
      <a
        href="#apps"
        class="btn-primary-tactile group inline-flex items-center gap-2 rounded-full px-6 py-3 text-[15px] font-semibold text-white"
      >
        <span data-i18n-key="heroCtaExplore">Explore the apps</span>
        <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
      </a>
      <a
        href="https://github.com/vicanso"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary-tactile group inline-flex items-center gap-2 rounded-full px-6 py-3 text-[15px] font-semibold"
        style="color: var(--text-primary);"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"></path></svg>
        <span data-i18n-key="navGitHub">GitHub</span>
        <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 font-mono text-[12px] tabular-nums" style="background: var(--accent-soft); color: var(--accent);">
          <svg class="h-3 w-3 fill-current" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          <span id="total-stars-count">{formatStars(TOTAL_STARS)}+</span>
        </span>
      </a>
    </div>

  </div>

  <!-- 3D product collage -->
  <div class="collage hero-in relative mx-auto mt-10 mb-16 sm:mb-0 w-full max-w-[1120px] sm:mt-14" style="--d: 420ms;" aria-hidden="true">
    <!-- glow under the stage -->
    <div class="pointer-events-none absolute inset-x-[10%] top-[20%] bottom-0 rounded-full blur-[80px]" style="background: radial-gradient(ellipse at center, var(--aurora-1), var(--aurora-3) 50%, transparent 75%);"></div>

    <div class="collage-stage relative aspect-[16/10] sm:aspect-[16/8.4]">
      <!-- Left: CyberAPI -->
      <div class="collage-window float-b hidden sm:block left-[0%] top-[16%] w-[46%]" style="transform: translateZ(-80px) rotateY(16deg);">
        <div class="flex h-7 items-center gap-1.5 border-b border-white/8 bg-white/[0.04] px-3">
          <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f56]"></span><span class="h-2.5 w-2.5 rounded-full bg-[#ffbd2e]"></span><span class="h-2.5 w-2.5 rounded-full bg-[#27c93f]"></span>
          <span class="ml-2 font-mono text-[10.5px] text-neutral-400">CyberAPI.app</span>
        </div>
        <Image src={cyberapiShot} alt="" widths={[640, 960]} sizes="(max-width: 1120px) 46vw, 520px" format="webp" class="aspect-[16/10] w-full object-cover object-top" loading="eager" />
      </div>

      <!-- Right: Zniff mock -->
      <div class="collage-window float-c hidden sm:block right-[0%] top-[12%] w-[46%]" style="transform: translateZ(-80px) rotateY(-16deg);">
        <div class="flex h-7 items-center justify-between border-b border-white/8 bg-white/[0.04] px-3">
          <div class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f56]"></span><span class="h-2.5 w-2.5 rounded-full bg-[#ffbd2e]"></span><span class="h-2.5 w-2.5 rounded-full bg-[#27c93f]"></span>
            <span class="ml-2 font-mono text-[10.5px] text-neutral-400">Zniff · :8888</span>
          </div>
          <span class="rounded bg-emerald-500/15 px-1.5 font-mono text-[9.5px] text-emerald-400">HTTPS</span>
        </div>
        <div class="aspect-[16/10] p-3 font-mono text-[10.5px] text-slate-300">
          <div class="grid grid-cols-12 gap-2 border-b border-white/10 pb-1.5 text-[9.5px] text-slate-500">
            <span class="col-span-2">METHOD</span><span class="col-span-6">HOST / PATH</span><span class="col-span-2">CODE</span><span class="col-span-2 text-right">TIME</span>
          </div>
          {[
            ['POST', 'text-sky-400', 'api.vicanso.dev/graphql', '200', 'w-10', 'bg-sky-400', '18ms', true],
            ['GET', 'text-emerald-400', 'cdn.zedis.net/latest.json', '200', 'w-6', 'bg-emerald-400', '9ms', false],
            ['PUT', 'text-amber-400', 'pingap.io/v1/upstreams', '204', 'w-8', 'bg-amber-400', '14ms', false],
            ['GET', 'text-violet-400', 'auth.local/oauth/token', '304', 'w-4', 'bg-violet-400', '4ms', false],
            ['WS', 'text-rose-400', 'live.vicanso.dev/stream', '101', 'w-12', 'bg-rose-400', '32ms', false],
          ].map(([m, mc, path, code, w, bc, t, active]) => (
            <div class={`mt-1.5 grid grid-cols-12 items-center gap-2 rounded px-1 py-1 ${active ? 'bg-white/5' : ''}`}>
              <span class={`col-span-2 ${mc}`}>{m}</span>
              <span class="col-span-6 truncate">{path}</span>
              <span class="col-span-2 text-emerald-400">{code}</span>
              <span class="col-span-2 flex items-center justify-end gap-1"><span class={`h-1 rounded-full ${w} ${bc} opacity-80`}></span></span>
            </div>
          ))}
          <div class="mt-3 rounded-md border border-white/10 bg-black/30 p-2 text-[9.5px] text-slate-400">
            <span class="text-amber-400">JSON</span> {'{ "protocol": "h2", "tls": "1.3" }'}
          </div>
        </div>
      </div>

      <!-- Center: Zedis (hero) -->
      <div class="collage-window float-a left-[4%] top-[2%] w-[92%] sm:left-[19%] sm:w-[62%]" style="transform: translateZ(40px);">
        <div class="flex h-8 items-center justify-between border-b border-white/8 bg-white/[0.05] px-3.5">
          <div class="flex items-center gap-1.5">
            <span class="h-3 w-3 rounded-full bg-[#ff5f56]"></span><span class="h-3 w-3 rounded-full bg-[#ffbd2e]"></span><span class="h-3 w-3 rounded-full bg-[#27c93f]"></span>
          </div>
          <span class="font-mono text-[11px] text-neutral-400">Zedis.app</span>
          <span class="w-12"></span>
        </div>
        <Image src={zedisShot} alt="" widths={[720, 1080, 1440]} sizes="(max-width: 640px) 92vw, 700px" format="webp" class="aspect-[16/10] w-full object-cover object-top" loading="eager" />
      </div>

      <!-- Floating terminal: httpstat -->
      <div class="collage-window float-b right-[2%] bottom-[-16%] w-[60%] sm:right-[6%] sm:bottom-[2%] sm:w-[34%]" style="transform: translateZ(120px); background: rgba(10,12,16,0.92); backdrop-filter: blur(12px);">
        <div class="flex h-6 items-center gap-1.5 border-b border-white/8 px-3">
          <span class="h-2 w-2 rounded-full bg-white/20"></span><span class="h-2 w-2 rounded-full bg-white/20"></span><span class="h-2 w-2 rounded-full bg-white/20"></span>
          <span class="ml-1.5 font-mono text-[10px] text-neutral-500">~ zsh</span>
        </div>
        <div class="p-3 font-mono text-[9.5px] leading-[1.7] text-slate-300 sm:text-[10.5px]">
          <div><span class="text-orange-400">❯</span> httpstat https://vicanso.dev</div>
          <div class="text-slate-500">HTTP/2 200 · TLSv1.3</div>
          <div class="mt-1 grid grid-cols-5 gap-1 text-center text-[8.5px] sm:text-[9.5px]">
            <span class="text-sky-400">DNS</span><span class="text-emerald-400">TCP</span><span class="text-amber-400">TLS</span><span class="text-rose-400">TTFB</span><span class="text-violet-400">XFER</span>
            <span>8ms</span><span>12ms</span><span>21ms</span><span>34ms</span><span>3ms</span>
          </div>
          <div class="mt-1.5 flex h-1.5 overflow-hidden rounded-full">
            <span class="w-[10%] bg-sky-400"></span><span class="w-[15%] bg-emerald-400"></span><span class="w-[27%] bg-amber-400"></span><span class="w-[43%] bg-rose-400"></span><span class="w-[5%] bg-violet-400"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
