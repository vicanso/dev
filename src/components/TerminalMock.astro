---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ProjectMeta, RepoStats } from '../data/projects';
import { formatStars } from '../data/projects';

interface Props {
  project: ProjectMeta;
  stats?: RepoStats;
  screenshot?: ImageMetadata;
  wide?: boolean;
}

const { project, stats, screenshot, wide = false } = Astro.props;
const stars = stats?.stars ?? 0;
const latestTag = stats?.latestTag;
---

<article
  class={`surface-card flex flex-col justify-between p-5 sm:p-6 overflow-hidden ${
    wide ? 'lg:col-span-2 lg:grid lg:grid-cols-12 lg:items-center lg:gap-7' : ''
  }`}
>
  <div class={wide ? 'lg:col-span-5 flex flex-col justify-between h-full min-w-0' : 'min-w-0'}>
    <div>
      <div class="flex items-start justify-between gap-2.5 sm:gap-3">
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <a
              href={`/${project.id}`}
              class="text-[19px] sm:text-[20px] font-semibold tracking-tight hover:underline truncate"
              style="color: var(--text-primary);"
            >
              {project.name}
            </a>
            {
              latestTag && (
                <span
                  data-tag-id={project.id}
                  class="rounded-md border px-1.5 py-0.5 font-mono text-[11px] tabular-nums shrink-0"
                  style="border-color: var(--border-subtle); color: var(--text-muted);"
                >
                  {latestTag}
                </span>
              )
            }
          </div>
          <div class="mt-1.5 flex flex-wrap gap-1.5">
            {
              project.platforms.map((tag) => (
                <span
                  class="rounded-md px-1.5 py-0.5 font-mono text-[11px] border border-black/5 dark:border-white/5"
                  style="background-color: var(--bg-elevated); color: var(--text-muted);"
                >
                  {tag}
                </span>
              ))
            }
          </div>
        </div>

        <a
          href={`https://github.com/${project.repo}/stargazers`}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex shrink-0 items-center gap-1 rounded-full border px-2.5 py-1 font-mono text-[12px] font-medium tabular-nums transition-all hover:border-amber-500/40"
          style="border-color: var(--border-subtle); background-color: var(--bg-canvas); color: var(--text-secondary);"
        >
          <svg class="h-3.5 w-3.5 fill-amber-400 text-amber-400" viewBox="0 0 24 24" aria-hidden="true">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          <span data-star-id={project.id}>{formatStars(stars)}</span>
          <svg
            class="h-3 w-3 opacity-50 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </div>

      <p
        class="mt-3.5 text-[14px] sm:text-[14.5px] leading-relaxed"
        style="color: var(--text-secondary);"
        data-en={project.tagline.en}
        data-zh={project.tagline.zh}
      >
        {project.tagline.en}
      </p>
    </div>

    {
      wide && (
        <div class="mt-5 space-y-2.5">
          {project.installCmd && (
            <div
              class="flex items-center justify-between gap-2 rounded-xl border px-3 py-2 font-mono text-[12px] shadow-inner overflow-hidden"
              style="border-color: var(--border-subtle); background-color: var(--bg-canvas); color: var(--text-secondary);"
            >
              <div class="min-w-0 flex-1 truncate">
                <code class="truncate block">
                  <span class="font-bold select-none" style="color: var(--accent);">$</span> {project.installCmd}
                </code>
              </div>
              <button
                type="button"
                data-copy-text={project.installCmd}
                class="shrink-0 inline-flex items-center gap-1.5 rounded-lg border px-2.5 py-1 text-[11.5px] font-sans font-medium transition-all cursor-pointer hover:bg-white/5 active:scale-95"
                style="border-color: var(--border-subtle); color: var(--text-primary);"
              >
                <svg class="copy-icon h-3.5 w-3.5 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <svg class="check-icon hidden h-3.5 w-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span data-copy-label data-i18n-key="btnCopy">Copy</span>
              </button>
            </div>
          )}
          <div class="flex items-center gap-2">
            <a
              href={`/${project.id}`}
              class="btn-secondary-tactile inline-flex flex-1 items-center justify-center rounded-xl px-3 py-1.5 text-[13px] font-medium"
              style="color: var(--text-primary);"
              data-i18n-key="btnDetails"
            >
              Details
            </a>
            <a
              href={`https://github.com/${project.repo}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary-tactile group inline-flex items-center justify-center gap-1 rounded-xl px-3 py-1.5 text-[13px] font-medium"
              style="color: var(--text-secondary);"
            >
              <span data-i18n-key="btnSource">Source</span>
              <svg
                class="h-3 w-3 opacity-50 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
          </div>
        </div>
      )
    }
  </div>

  <!-- Terminal / Browser Window Visual Frame -->
  <a
    href={`/${project.id}`}
    class={`block ${wide ? 'mt-5 lg:mt-0 lg:col-span-7' : 'mt-4'}`}
    aria-label={`View ${project.name} details`}
  >
    {
      project.id === 'diving-rs' ? (
        <!-- Simulated Browser Frame for Light Web Dashboard -->
        <div class="overflow-hidden rounded-xl border border-black/10 dark:border-white/10 bg-[#0d1017] shadow-xl transition-all duration-200 hover:border-black/20 dark:hover:border-white/20">
          <div class="flex h-7 items-center justify-between border-b border-black/5 dark:border-white/8 bg-black/[0.02] dark:bg-white/[0.04] px-3">
            <div class="flex items-center gap-1.5 shrink-0">
              <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f56] border border-[#e0443e]/50"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#ffbd2e] border border-[#dea123]/50"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#27c93f] border border-[#1aab29]/50"></span>
            </div>
            <div class="mx-2 flex max-w-[200px] flex-1 items-center justify-center">
              <div class="flex w-full items-center justify-center gap-1.5 rounded-md border border-black/10 dark:border-white/10 bg-black/5 dark:bg-black/40 px-2 py-0.5 font-mono text-[10px] text-neutral-400">
                <svg class="h-2.5 w-2.5 text-neutral-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <span class="truncate">localhost:8080</span>
              </div>
            </div>
            <div class="w-8 shrink-0"></div>
          </div>
          <div class="aspect-[16/10] overflow-hidden bg-white">
            {screenshot && (
              <Image
                src={screenshot}
                alt={`${project.name} web UI preview`}
                class="h-full w-full object-cover object-top transition-transform duration-300 hover:scale-[1.015]"
                widths={[640, 1080]}
                sizes="(max-width: 768px) 100vw, 540px"
                format="webp"
              />
            )}
          </div>
        </div>
      ) : (
        <!-- Authentic macOS Terminal Window Frame -->
        <div class="overflow-hidden rounded-xl border border-black/10 dark:border-white/10 bg-[#0d1017] shadow-xl transition-all duration-200 hover:border-black/20 dark:hover:border-white/20">
          <div class="flex h-7 items-center justify-between border-b border-black/5 dark:border-white/8 bg-black/[0.02] dark:bg-white/[0.04] px-3">
            <div class="flex items-center gap-1.5">
              <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f56] border border-[#e0443e]/50"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#ffbd2e] border border-[#dea123]/50"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#27c93f] border border-[#1aab29]/50"></span>
            </div>
            <span class="font-mono text-[10.5px] text-neutral-400 select-none opacity-80">{project.name} — terminal</span>
            <div class="w-8"></div>
          </div>
          <div class="aspect-[16/10] overflow-hidden bg-[#0d1017]">
            {screenshot ? (
              <Image
                src={screenshot}
                alt={`${project.name} output preview`}
                class="h-full w-full object-cover object-top transition-transform duration-300 hover:scale-[1.015]"
                widths={[640, 1080]}
                sizes="(max-width: 768px) 100vw, 540px"
                format="webp"
              />
            ) : (
              <div class="p-4 font-mono text-[12px] text-slate-300">$ {project.installCmd}</div>
            )}
          </div>
        </div>
      )
    }
  </a>

  {
    !wide && (
      <div class="mt-4 space-y-2.5">
        {project.installCmd && (
          <div
            class="flex items-center justify-between gap-2 rounded-xl border px-3 py-2 font-mono text-[12px] shadow-inner overflow-hidden"
            style="border-color: var(--border-subtle); background-color: var(--bg-canvas); color: var(--text-secondary);"
          >
            <div class="min-w-0 flex-1 truncate">
              <code class="truncate block">
                <span class="font-bold select-none" style="color: var(--accent);">$</span> {project.installCmd}
              </code>
            </div>
            <button
              type="button"
              data-copy-text={project.installCmd}
              class="shrink-0 inline-flex items-center gap-1.5 rounded-lg border px-2.5 py-1 text-[11.5px] font-sans font-medium transition-all cursor-pointer hover:bg-white/5 active:scale-95"
              style="border-color: var(--border-subtle); color: var(--text-primary);"
            >
              <svg class="copy-icon h-3.5 w-3.5 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <svg class="check-icon hidden h-3.5 w-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span data-copy-label data-i18n-key="btnCopy">Copy</span>
            </button>
          </div>
        )}
        <div class="flex items-center gap-2">
          <a
            href={`/${project.id}`}
            class="btn-secondary-tactile inline-flex flex-1 items-center justify-center rounded-xl px-3 py-1.5 text-[13px] font-medium"
            style="color: var(--text-primary);"
            data-i18n-key="btnDetails"
          >
            Details
          </a>
          <a
            href={`https://github.com/${project.repo}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary-tactile group inline-flex items-center justify-center gap-1 rounded-xl px-3 py-1.5 text-[13px] font-medium"
            style="color: var(--text-secondary);"
          >
            <span data-i18n-key="btnSource">Source</span>
            <svg
              class="h-3 w-3 opacity-50 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
        </div>
      </div>
    )
  }
</article>
