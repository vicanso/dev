---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ProjectMeta, RepoStats } from '../data/projects';
import { formatStars } from '../data/projects';

interface Props {
  project: ProjectMeta;
  stats?: RepoStats;
  screenshot?: ImageMetadata;
}

const { project, stats, screenshot } = Astro.props;
const stars = stats?.stars ?? 0;
const latestTag = stats?.latestTag;
const isWide = Boolean(project.featuredWide);
---

<article
  class={`surface-card flex flex-col justify-between p-5 sm:p-6 ${
    isWide ? 'lg:col-span-2 lg:grid lg:grid-cols-12 lg:items-center lg:gap-7' : ''
  }`}
>
  <div class={isWide ? 'lg:col-span-5 flex flex-col justify-between h-full' : ''}>
    <div>
      <!-- Top Row: Icon + Name + Star Pill -->
      <div class="flex items-start justify-between gap-2.5 sm:gap-3">
        <div class="flex items-center gap-3 sm:gap-3.5 min-w-0">
          {
            project.icon && (
              <img
                src={project.icon}
                alt={`${project.name} icon`}
                width="64"
                height="64"
                class="app-squircle h-13 w-13 shrink-0 object-cover sm:h-16 sm:w-16"
                loading="lazy"
              />
            )
          }
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
              <a
                href={`/${project.id}`}
                class="text-[19px] sm:text-[20px] font-semibold tracking-tight hover:underline truncate"
                style="color: var(--text-primary);"
              >
                {project.name}
              </a>
              {
                latestTag && (
                  <span
                    data-tag-id={project.id}
                    class="rounded-md border px-1.5 py-0.5 font-mono text-[11px] tabular-nums shrink-0"
                    style="border-color: var(--border-subtle); color: var(--text-muted);"
                  >
                    {latestTag}
                  </span>
                )
              }
            </div>
            <div class="mt-1.5 flex flex-wrap gap-1 sm:gap-1.5">
              {
                project.platforms.map((tag) => (
                  <span
                    class="rounded-md px-1.5 py-0.5 font-mono text-[10.5px] sm:text-[11px] border border-black/5 dark:border-white/5"
                    style="background-color: var(--bg-elevated); color: var(--text-muted);"
                  >
                    {tag}
                  </span>
                ))
              }
            </div>
          </div>
        </div>

        <a
          href={`https://github.com/${project.repo}/stargazers`}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex shrink-0 items-center gap-1 rounded-full border px-2.5 py-1 font-mono text-[12px] font-medium tabular-nums transition-all hover:border-amber-500/40"
          style="border-color: var(--border-subtle); background-color: var(--bg-canvas); color: var(--text-secondary);"
          title="GitHub Stars"
        >
          <svg class="h-3.5 w-3.5 fill-amber-400 text-amber-400" viewBox="0 0 24 24" aria-hidden="true">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          <span data-star-id={project.id}>{formatStars(stars)}</span>
          <svg
            class="h-3 w-3 opacity-50 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </div>

      <!-- Tagline -->
      <p
        class="mt-3.5 text-[14px] sm:text-[14.5px] leading-relaxed"
        style="color: var(--text-secondary);"
        data-en={project.tagline.en}
        data-zh={project.tagline.zh}
      >
        {project.tagline.en}
      </p>
    </div>

    {
      isWide && (
        <div class="mt-5 flex flex-wrap items-center gap-2.5">
          <a
            href={`/${project.id}`}
            class="btn-primary-tactile inline-flex items-center gap-2 rounded-xl px-4 py-2 text-[13.5px] font-semibold text-white shadow-sm"
          >
            <svg
              class="h-3.5 w-3.5 stroke-white"
              viewBox="0 0 24 24"
              fill="none"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span data-i18n-key="btnDownload">Download</span>
          </a>
          <a
            href={`https://github.com/${project.repo}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary-tactile group inline-flex items-center gap-1.5 rounded-xl px-3.5 py-2 text-[13.5px] font-medium"
            style="color: var(--text-primary);"
          >
            <span data-i18n-key="btnSource">Source</span>
            <svg
              class="h-3 w-3 opacity-50 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
        </div>
      )
    }
  </div>

  <!-- Visual Preview with Native macOS Window Frame -->
  <a
    href={`/${project.id}`}
    class={`block ${isWide ? 'mt-5 lg:mt-0 lg:col-span-7' : 'mt-5'}`}
    aria-label={`View ${project.name} details`}
  >
    {
      screenshot ? (
        <div class="overflow-hidden rounded-xl border border-black/10 dark:border-white/10 bg-[#0d1017] shadow-xl transition-all duration-200 hover:border-black/20 dark:hover:border-white/20">
          <!-- Authentic macOS Window Header Bar -->
          <div class="flex h-7 items-center justify-between border-b border-black/5 dark:border-white/8 bg-black/[0.02] dark:bg-white/[0.04] px-3">
            <div class="flex items-center gap-1.5">
              <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f56] border border-[#e0443e]/50"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#ffbd2e] border border-[#dea123]/50"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#27c93f] border border-[#1aab29]/50"></span>
            </div>
            <span class="font-mono text-[11px] text-neutral-400 select-none opacity-80">{project.name}.app</span>
            <div class="w-8"></div>
          </div>
          <!-- Screenshot Image without cloudy fade -->
          <div class="aspect-[16/10] overflow-hidden bg-black/40">
            <Image
              src={screenshot}
              alt={`${project.name} interface preview`}
              class="h-full w-full object-cover object-top transition-transform duration-300 hover:scale-[1.015]"
              widths={[640, 1080]}
              sizes="(max-width: 768px) 100vw, 540px"
              format="webp"
            />
          </div>
        </div>
      ) : (
        <!-- High-fidelity native NSH HTTP(S) traffic sniffer mockup for Zniff with authentic traffic lights -->
        <div class="overflow-hidden rounded-xl border border-black/10 dark:border-white/10 bg-[#0d1016] shadow-xl">
          <div class="flex h-7 items-center justify-between border-b border-white/10 bg-white/[0.04] px-3">
            <div class="flex items-center gap-1.5">
              <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f56] border border-[#e0443e]/50"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#ffbd2e] border border-[#dea123]/50"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#27c93f] border border-[#1aab29]/50"></span>
              <span class="ml-2 font-mono text-[10.5px] text-slate-400">Zniff · :8888 (MITM Active)</span>
            </div>
            <span class="rounded bg-emerald-500/15 px-1.5 py-0.2 font-mono text-[10px] text-emerald-400">HTTPS Decrypted</span>
          </div>

          <div class="flex h-full w-full flex-col p-3 font-mono text-[11px] text-slate-300 select-none">
            <div class="grid grid-cols-12 gap-2 border-b border-white/10 pb-1 text-[10px] text-slate-500">
              <span class="col-span-2">METHOD</span>
              <span class="col-span-5">HOST / PATH</span>
              <span class="col-span-2">STATUS</span>
              <span class="col-span-3 text-right">WATERFALL</span>
            </div>
            <div class="mt-1.5 space-y-1.5">
              <div class="grid grid-cols-12 items-center gap-2 rounded bg-white/5 px-1.5 py-1">
                <span class="col-span-2 text-sky-400">POST</span>
                <span class="col-span-5 truncate text-slate-200">api.vicanso.dev/graphql</span>
                <span class="col-span-2 text-emerald-400">200</span>
                <div class="col-span-3 flex items-center justify-end gap-1.5">
                  <span class="h-1.5 w-12 rounded-full bg-sky-400/80"></span>
                  <span class="text-[10px] text-slate-400">18ms</span>
                </div>
              </div>
              <div class="grid grid-cols-12 items-center gap-2 px-1.5 py-1">
                <span class="col-span-2 text-emerald-400">GET</span>
                <span class="col-span-5 truncate text-slate-300">cdn.zedis.net/v0.16/latest.json</span>
                <span class="col-span-2 text-emerald-400">200</span>
                <div class="col-span-3 flex items-center justify-end gap-1.5">
                  <span class="h-1.5 w-8 rounded-full bg-emerald-400/80"></span>
                  <span class="text-[10px] text-slate-400">9ms</span>
                </div>
              </div>
              <div class="grid grid-cols-12 items-center gap-2 px-1.5 py-1">
                <span class="col-span-2 text-amber-400">PUT</span>
                <span class="col-span-5 truncate text-slate-300">grpc.pingap.io/v1/Upstreams</span>
                <span class="col-span-2 text-emerald-400">204</span>
                <div class="col-span-3 flex items-center justify-end gap-1.5">
                  <span class="h-1.5 w-10 rounded-full bg-amber-400/80"></span>
                  <span class="text-[10px] text-slate-400">14ms</span>
                </div>
              </div>
              <div class="grid grid-cols-12 items-center gap-2 px-1.5 py-1">
                <span class="col-span-2 text-violet-400">GET</span>
                <span class="col-span-5 truncate text-slate-400">auth.local/oauth/token</span>
                <span class="col-span-2 text-amber-400">304</span>
                <div class="col-span-3 flex items-center justify-end gap-1.5">
                  <span class="h-1.5 w-5 rounded-full bg-violet-400/80"></span>
                  <span class="text-[10px] text-slate-400">4ms</span>
                </div>
              </div>
            </div>
            <div class="mt-3 rounded-lg border border-white/10 bg-black/30 p-2 text-[10px] text-slate-400">
              <span class="text-amber-400">JSON</span> · {"{ \"protocol\": \"h2\", \"tls\": \"1.3\", \"ttfb\": \"11.2ms\" }"}
            </div>
          </div>
        </div>
      )
    }
  </a>

  {
    !isWide && (
      <div class="mt-5 flex items-center justify-between gap-2.5">
        <a
          href={`/${project.id}`}
          class="btn-primary-tactile inline-flex flex-1 items-center justify-center gap-1.5 rounded-xl px-3.5 py-2 text-[13.5px] font-semibold text-white shadow-sm"
        >
          <svg
            class="h-3.5 w-3.5 stroke-white"
            viewBox="0 0 24 24"
            fill="none"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span data-i18n-key="btnDownload">Download</span>
        </a>
        <a
          href={`https://github.com/${project.repo}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary-tactile group inline-flex items-center justify-center gap-1.5 rounded-xl px-3.5 py-2 text-[13.5px] font-medium"
          style="color: var(--text-primary);"
        >
          <span data-i18n-key="btnSource">Source</span>
          <svg
            class="h-3 w-3 opacity-50 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </div>
    )
  }
</article>
