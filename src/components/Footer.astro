---
---

<footer class="mt-auto border-t py-8 transition-colors" style="border-color: var(--border-subtle);">
  <div class="mx-auto flex max-w-[1120px] flex-col items-start justify-between gap-3 px-4 text-[13px] sm:flex-row sm:items-center sm:px-6" style="color: var(--text-muted);">
    <div class="flex flex-wrap items-center gap-2">
      <span class="font-medium text-neutral-400">© {new Date().getFullYear()} Vicanso</span>
      <span>·</span>
      <span data-i18n-key="footerBuilt">Built with Astro · Hosted on Cloudflare Pages</span>
    </div>
    <a
      href="https://github.com/vicanso"
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex items-center gap-1.5 transition-colors hover:text-white"
      style="color: var(--text-secondary);"
    >
      <span>github.com/vicanso</span>
      <svg
        class="h-3 w-3 opacity-50 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="7" y1="17" x2="17" y2="7"></line>
        <polyline points="7 7 17 7 17 17"></polyline>
      </svg>
    </a>
  </div>
</footer>
