---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import WhyNative from '../components/WhyNative.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FilterBar from '../components/FilterBar.astro';
import AppCard from '../components/AppCard.astro';
import PingapBanner from '../components/PingapBanner.astro';
import ChartsPreview from '../components/ChartsPreview.astro';
import TerminalMock from '../components/TerminalMock.astro';
import { PROJECTS, INITIAL_STATS } from '../data/projects';

import zedisShot from '../assets/screenshots/zedis-1.png';
import cyberapiShot from '../assets/screenshots/cyberapi-1.png';
import divingShot from '../assets/screenshots/diving-1.png';
import httpstatShot from '../assets/screenshots/httpstat-1.png';

const desktopApps = PROJECTS.filter((p) => p.category === 'desktop');
const infraProjects = PROJECTS.filter((p) => p.category === 'infra');
const cliProjects = PROJECTS.filter((p) => p.category === 'cli');

const screenshotMap = {
  zedis: zedisShot,
  cyberapi: cyberapiShot,
  diving: divingShot,
  httpstat: httpstatShot,
};

const counts = {
  all: PROJECTS.length,
  desktop: desktopApps.length,
  infra: infraProjects.length,
  cli: cliProjects.length,
};
---

<BaseLayout>
  <Header />

  <main class="mx-auto w-full max-w-[1120px] flex-1 px-4 sm:px-6">
    <Hero />

    <WhyNative />

    <!-- Works -->
    <section class="scroll-mt-24" id="apps">
      <div class="mb-10 flex flex-col items-center text-center" data-reveal>
        <div class="eyebrow" data-i18n-key="worksEyebrow">Selected work</div>
        <h2 class="font-display text-gradient-fade mt-4 text-[34px] font-bold leading-[1.08] sm:text-[48px]" data-i18n-key="worksTitle">
          Tools I build & maintain
        </h2>
        <div class="mt-8">
          <FilterBar counts={counts} />
        </div>
      </div>

      <!-- 1. Native Desktop Apps -->
      <section data-category-section="desktop" class="mb-16">
        <SectionHeading
          index="01"
          dot="#f97316"
          titleKey="sectionDesktop"
          title="Native Desktop Apps"
          subKey="sectionDesktopSub"
          sub="Built with Rust, GPUI & NSH — zero Electron bloat."
        />
        <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
          {
            desktopApps.map((project, i) => (
              <div data-reveal style={`--reveal-delay: ${(i % 2) * 90}ms;`} class={`flex flex-col [&>article]:flex-1 ${project.featuredWide ? "lg:col-span-2" : ""}`}>
                <AppCard
                  project={project}
                  stats={INITIAL_STATS[project.id]}
                  screenshot={project.id === 'zedis' ? screenshotMap.zedis : project.id === 'cyberapi' ? screenshotMap.cyberapi : undefined}
                />
              </div>
            ))
          }
        </div>
      </section>

      <!-- 2. Network Infrastructure -->
      <section data-category-section="infra" class="mb-16">
        <SectionHeading
          index="02"
          dot="#f43f5e"
          titleKey="sectionInfra"
          title="Network Infrastructure"
          subKey="sectionInfraSub"
          sub="Battle-tested proxying on Cloudflare Pingora."
        />
        <div class="space-y-5">
          {infraProjects.map((project) => (
            <div data-reveal>
              <PingapBanner project={project} stats={INITIAL_STATS[project.id]} />
            </div>
          ))}
        </div>
      </section>

      <!-- 3. CLI Tools & Libraries -->
      <section data-category-section="cli" class="mb-6">
        <SectionHeading
          index="03"
          dot="#a855f7"
          titleKey="sectionCli"
          title="CLI Tools & Libraries"
          subKey="sectionCliSub"
          sub="Sharp, single-binary tools for the terminal."
        />
        <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
          {
            cliProjects.map((project, i) => {
              const delay = `--reveal-delay: ${(i % 2) * 90}ms;`;
              if (project.id === 'charts-rs') {
                return (
                  <div data-reveal style={delay} class="flex flex-col [&>article]:flex-1">
                    <ChartsPreview project={project} stats={INITIAL_STATS[project.id]} />
                  </div>
                );
              }
              if (project.id === 'diving-rs') {
                return (
                  <div data-reveal style={delay} class="flex flex-col [&>article]:flex-1">
                    <TerminalMock project={project} stats={INITIAL_STATS[project.id]} screenshot={screenshotMap.diving} />
                  </div>
                );
              }
              return (
                <div data-reveal class="flex flex-col [&>article]:flex-1 lg:col-span-2">
                  <TerminalMock project={project} stats={INITIAL_STATS[project.id]} screenshot={screenshotMap.httpstat} wide={true} />
                </div>
              );
            })
          }
        </div>
      </section>
    </section>
  </main>

  <Footer cta />
</BaseLayout>
